<?xml version="1.0" encoding="utf-8"?>
<!-- PB-032: Android 12+ (API 31) sistem açılış ekranı.
     Uygulama açılışında beyaz flaş olmaz; koyu neon zemin + ikon.
     NOT: `android:postSplashScreenTheme` Android SDK'sında YOKTUR (native
     androidx-splashscreen özniteliğidir) → Flutter şablonunda kullanılmaz. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
